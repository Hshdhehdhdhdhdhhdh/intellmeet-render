# --- Required ----------------------------------------------------------------
PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/intellmeet
# long random string (>= 32 chars): openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# --- Video calls across different networks (TURN relay) -----------------------
# WebRTC needs a TURN relay so people on mobile data / office Wi-Fi / different
# networks can see each other. Pick ONE option (free):
#  A) Metered (free tier): create an app at https://www.metered.ca/tools/openrelay/
#     METERED_DOMAIN=yourapp.metered.live
#     METERED_API_KEY=xxxxxxxxxxxxxxxx
#  B) Any TURN server you run (e.g. coturn):
#     TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:443?transport=tcp
#     TURN_USERNAME=user
#     TURN_CREDENTIAL=password
# If you set nothing, a public community relay is used as a fallback (works for demos,
# but is shared and not guaranteed).
METERED_DOMAIN=
METERED_API_KEY=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- AI features (meeting summary, transcription, copilot) --------------------
# On Manus hosting these are provided automatically. On any other host (Render, Railway, VPS)
# point them at an OpenAI-compatible API:
BUILT_IN_FORGE_API_URL=https://api.openai.com
BUILT_IN_FORGE_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Durable object storage on external hosts (Cloudflare R2) -----------------
# Create an R2 bucket and an Object Read & Write token scoped to this bucket.
# R2_ENDPOINT includes your Cloudflare account ID. Region for R2 is `auto`.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=intellmeet
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
